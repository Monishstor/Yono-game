{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "app",
          "value": "(?<slug>[a-zA-Z0-9_-]+)"
        }
      ],
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "game",
          "value": "(?<slug>[a-zA-Z0-9_-]+)"
        }
      ],
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "apk",
          "value": "(?<slug>[a-zA-Z0-9_-]+)"
        }
      ],
      "destination": "/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app/:slug",
      "destination": "/app/:slug/index.html"
    },
    {
      "source": "/:slug([a-zA-Z0-9_-]+-apk-download)",
      "destination": "/:slug/index.html"
    },
    {
      "source": "/((?!assets|public|app|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
